<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusRating.ViewModels"
             xmlns:model="clr-namespace:CampusRating.Modelos"
             xmlns:ui="clr-namespace:CampusRating.Componentes"
             x:Class="CampusRating.DetalhesLocalPage" x:DataType="vm:DetalhesLocalViewModel"
             Title="Detalhes do local" BackgroundColor="White">
    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="720" HorizontalOptions="Fill">
        <Grid>
            <VerticalStackLayout IsVisible="{Binding Carregando}" Padding="24,32" Spacing="12">
                <ActivityIndicator IsRunning="{Binding Carregando}" Color="#6251D2" />
                <Label Text="Carregando o local..." Style="{StaticResource TextoDeApoio}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding MostrarErro}" Padding="24,28" Spacing="16">
                <ui:AvisoDaInterface Tom="Erro" Titulo="Não foi possível carregar o local" Mensagem="{Binding Erro}" />
                <Button Text="Tentar novamente" Clicked="OnRetryClicked" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Comentarios}" IsVisible="{Binding MostrarDetalhes}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="24,20,24,12" Spacing="14">
                        <ui:AvisoDaInterface Titulo="Cópia no dispositivo" Mensagem="{Binding MensagemLocal}" />
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="180">
                            <Image Source="{Binding Imagem}" Aspect="AspectFill" />
                        </Border>
                        <Label Text="Imagem ilustrativa" Style="{StaticResource TextoDeApoio}" FontSize="11" />
                        <Label Text="{Binding Nome}" Style="{StaticResource TituloDaPagina}" />
                        <Label Text="{Binding Categoria}" FontSize="13" TextColor="#5140B5" />
                        <Label Text="{Binding Localizacao}" Style="{StaticResource TextoDeApoio}" />
                        <Label Text="{Binding Descricao}" FontSize="15" LineHeight="1.3" />
                        <BoxView Style="{StaticResource Divisor}" />
                        <Label Text="{Binding Contagem}" Style="{StaticResource TituloDaSecao}" />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,16" Spacing="8">
                        <Label Text="Ainda não há comentários" Style="{StaticResource TituloDaSecao}" />
                        <Label Text="Os relatos deste espaço aparecerão aqui." Style="{StaticResource TextoDeApoio}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ComentarioDoLocal">
                        <VerticalStackLayout Padding="24,12,24,20" Spacing="10">
                            <Label Text="{Binding Apelido}" FontSize="15" TextColor="#5140B5" />
                            <Label Text="{Binding DataTexto}" Style="{StaticResource TextoDeApoio}" FontSize="12" />
                            <Label Text="{Binding Texto}" FontSize="15" LineHeight="1.3" />
                            <ui:SeloDeStatus Status="{Binding Status}" />
                            <Border IsVisible="{Binding TemRespostas}" Padding="14" StrokeThickness="0"
                                    BackgroundColor="#F5F1FF" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding RespostasTexto}" FontSize="14" LineHeight="1.4" />
                            </Border>
                            <BoxView Style="{StaticResource Divisor}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding MostrarDetalhes}" Padding="24,12,24,18" Spacing="8" BackgroundColor="White">
            <Button Text="Enviar relato" Clicked="OnSendReportClicked" />
            <Label Text="Seu relato será publicado com seu apelido e começará como Pendente."
                   Style="{StaticResource TextoDeApoio}" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
