<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CampusRating"
             x:Class="CampusRating.HomePage"
             x:DataType="local:HomePage"
             Title="Locais do campus" Shell.NavBarIsVisible="False"
             BackgroundColor="#FDFCFF">
    <ContentPage.Resources>
        <Style x:Key="CategoryChip" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#7D7B85" />
            <Setter Property="BorderColor" Value="#E5E3EA" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="720" HorizontalOptions="Fill">
        <Grid x:Name="PlacesPanel" RowDefinitions="Auto,*" Padding="22,28,22,0">
            <VerticalStackLayout Spacing="18" Margin="0,0,0,18">
                <Label Text="Locais do campus" FontSize="31" TextColor="#25242C" />
                <Border Padding="14,0" HeightRequest="54" BackgroundColor="White"
                        Stroke="#DDD9E4" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                        <Image Source="search_outline.png" WidthRequest="20" HeightRequest="20"
                               VerticalOptions="Center" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Buscar local"
                               PlaceholderColor="#98959F" TextColor="#25242C" FontSize="14"
                               VerticalOptions="Center" HeightRequest="44"
                               BackgroundColor="Transparent" TextChanged="OnSearchTextChanged" />
                    </Grid>
                </Border>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="CategoryButtons" Spacing="10">
                        <Button Text="Todos" CommandParameter="Todos" Style="{StaticResource CategoryChip}"
                                BackgroundColor="#F1EDFF" TextColor="#8065F1" BorderColor="#CEC0FF"
                                Clicked="OnCategoryClicked" />
                        <Button Text="Salas" CommandParameter="Salas" Style="{StaticResource CategoryChip}" Clicked="OnCategoryClicked" />
                        <Button Text="Banheiros" CommandParameter="Banheiros" Style="{StaticResource CategoryChip}" Clicked="OnCategoryClicked" />
                        <Button Text="Biblioteca" CommandParameter="Biblioteca" Style="{StaticResource CategoryChip}" Clicked="OnCategoryClicked" />
                        <Button Text="Cantina" CommandParameter="Cantina" Style="{StaticResource CategoryChip}" Clicked="OnCategoryClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="16,28" Spacing="8">
                        <Label Text="Nenhum local encontrado" FontSize="17" TextColor="#6251D2" />
                        <Label Text="Experimente outro nome ou categoria." FontSize="14" TextColor="#898794" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CampusPlace">
                        <Border Padding="12" Margin="1,0,1,4" Stroke="#EEEBF1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Brush="#181421" Offset="0,3" Radius="6" Opacity="0.07" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaceTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="96,*" ColumnSpacing="14" MinimumHeightRequest="120">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="120">
                                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Name}" FontSize="18" TextColor="#25242C"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1" Padding="7,5" StrokeThickness="0"
                                                BackgroundColor="#F1EDFF" StrokeShape="RoundRectangle 12"
                                                VerticalOptions="Start">
                                            <HorizontalStackLayout Spacing="4">
                                                <Image Source="star_purple.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
                                                <Label Text="{Binding Rating}" FontSize="13" TextColor="#8065F1" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="12,*" ColumnSpacing="5">
                                        <Image Source="location_gray.png" WidthRequest="11" HeightRequest="14" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Location}" FontSize="12" TextColor="#98959F" />
                                    </Grid>
                                    <Label Grid.Row="2" Text="{Binding Description}" FontSize="12"
                                           TextColor="#98959F" VerticalOptions="End" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Text="Locais e notas de exemplo" FontSize="11" TextColor="#A6A1B1"
                           HorizontalTextAlignment="Center" Margin="0,12,0,18" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <ScrollView x:Name="ProfilePanel" IsVisible="False">
            <VerticalStackLayout Padding="24,28" Spacing="20">
                <Label Text="Meu perfil" FontSize="31" TextColor="#25242C" />
                <Border Padding="24" BackgroundColor="#F5F2FF" Stroke="#D4CCFF" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <Image Source="campus_rating_logo.png" WidthRequest="64" HeightRequest="64" HorizontalOptions="Start" />
                        <Label Text="Seu apelido" FontSize="13" TextColor="#898794" />
                        <Label x:Name="NicknameLabel" Text="Seu perfil anônimo" FontSize="24" TextColor="#6251D2" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Voltar ao cadastro" BackgroundColor="#8065F1" TextColor="White"
                        CornerRadius="14" HeightRequest="52" Clicked="OnBackToRegistrationClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="NoticesPanel" IsVisible="False" Padding="24,28" Spacing="24">
            <Label Text="Avisos" FontSize="31" TextColor="#25242C" />
            <Border Padding="28" BackgroundColor="White" Stroke="#EEEBF1" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Image Source="bell_gray.png" WidthRequest="36" HeightRequest="36" />
                    <Label Text="Nenhum aviso por enquanto" FontSize="18" TextColor="#6251D2" HorizontalTextAlignment="Center" />
                    <Label Text="Os avisos da comunidade aparecerão aqui." FontSize="14" TextColor="#898794" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="1,76" BackgroundColor="White">
            <BoxView Color="#EEEBF1" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Padding="12,10,12,8">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnPlacesTabTapped" /></VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="PlacesTabIcon" Source="location_purple.png" WidthRequest="24" HeightRequest="26" />
                    <Label x:Name="PlacesTabLabel" Text="Locais" FontSize="12" TextColor="#8065F1" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTabTapped" /></VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="ProfileTabIcon" Source="profile_gray.png" WidthRequest="24" HeightRequest="26" />
                    <Label x:Name="ProfileTabLabel" Text="Perfil" FontSize="12" TextColor="#898794" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNoticesTabTapped" /></VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="NoticesTabIcon" Source="bell_gray.png" WidthRequest="24" HeightRequest="26" />
                    <Label x:Name="NoticesTabLabel" Text="Avisos" FontSize="12" TextColor="#898794" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
