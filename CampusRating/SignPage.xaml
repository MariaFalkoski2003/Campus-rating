<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusRating.ViewModels"
             xmlns:ui="clr-namespace:CampusRating.Componentes"
             x:Class="CampusRating.SignPage" x:DataType="vm:CadastroViewModel"
             Title="Criar conta" BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,28" Spacing="18" MaximumWidthRequest="440" HorizontalOptions="Fill">
            <Image Source="campus_rating_logo.png" HeightRequest="54" WidthRequest="54" HorizontalOptions="Start" />
            <VerticalStackLayout Spacing="6">
                <Label Text="Cadastro do aluno" Style="{StaticResource TituloDaPagina}" />
                <Label Text="Crie sua conta para acompanhar os relatos do campus." Style="{StaticResource TextoDeApoio}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="E-mail institucional" />
                <Border Style="{StaticResource CampoDeEntrada}">
                    <Entry x:Name="EmailEntry" Text="{Binding Email, Mode=TwoWay}" Placeholder="seu.email@aluno.uricer.edu.br"
                           Keyboard="Email" ReturnType="Next" Completed="OnEmailCompleted" IsEnabled="{Binding PodeEnviar}" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Senha" />
                <Border Style="{StaticResource CampoDeEntrada}">
                    <Grid ColumnDefinitions="*,44">
                        <Entry x:Name="PasswordEntry" Text="{Binding Senha, Mode=TwoWay}" Placeholder="Pelo menos 6 caracteres"
                               IsPassword="True" ReturnType="Next" Completed="OnPasswordCompleted" IsEnabled="{Binding PodeEnviar}" />
                        <ImageButton x:Name="PasswordVisibilityButton" Grid.Column="1" Source="eye_outline.png"
                                     BackgroundColor="Transparent" Padding="10" Clicked="OnTogglePasswordVisibility"
                                     IsEnabled="{Binding PodeEnviar}" SemanticProperties.Description="Mostrar ou ocultar senha" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Confirmar senha" />
                <Border Style="{StaticResource CampoDeEntrada}">
                    <Grid ColumnDefinitions="*,44">
                        <Entry x:Name="ConfirmPasswordEntry" Text="{Binding ConfirmacaoSenha, Mode=TwoWay}" Placeholder="Repita sua senha"
                               IsPassword="True" ReturnType="Done" Completed="OnConfirmPasswordCompleted" IsEnabled="{Binding PodeEnviar}" />
                        <ImageButton x:Name="ConfirmPasswordVisibilityButton" Grid.Column="1" Source="eye_outline.png"
                                     BackgroundColor="Transparent" Padding="10" Clicked="OnToggleConfirmPasswordVisibility"
                                     IsEnabled="{Binding PodeEnviar}" SemanticProperties.Description="Mostrar ou ocultar confirmação de senha" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
            <Border Padding="16" BackgroundColor="#F5F1FF" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Seu apelido na plataforma" Style="{StaticResource TextoDeApoio}" />
                    <Label Text="{Binding Apelido}" FontSize="21" TextColor="#5140B5" />
                    <Button Text="Sortear novamente" Style="{StaticResource BotaoContorno}"
                            IsEnabled="{Binding PodeEnviar}" Clicked="OnGenerateNickname" />
                </VerticalStackLayout>
            </Border>
            <ui:AvisoDaInterface Titulo="Privacidade" Mensagem="Seu apelido identifica seus relatos. Seu e-mail fica visível somente para você." />
            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                <CheckBox x:Name="RulesCheckBox" IsChecked="{Binding AceitouRegras, Mode=TwoWay}" IsEnabled="{Binding PodeEnviar}"
                          Color="#6251D2" VerticalOptions="Start" SemanticProperties.Description="Aceito as regras da plataforma" />
                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="Li e aceito as regras da plataforma." />
                    <Button Text="Ler regras e uso dos dados" Style="{StaticResource BotaoContorno}" Clicked="OnRulesClicked"
                            IsEnabled="{Binding PodeEnviar}" />
                </VerticalStackLayout>
            </Grid>
            <ui:AvisoDaInterface x:Name="ErroAviso" Tom="Erro" Titulo="Revise os dados" />
            <Button x:Name="CreateAccountButton" Text="{Binding TextoBotao}" IsEnabled="{Binding PodeEnviar}" Clicked="OnCreateAccountClicked" />
            <Button Text="Já tem uma conta? Entrar" Style="{StaticResource BotaoSecundario}"
                    IsEnabled="{Binding PodeEnviar}" Clicked="OnGoToLoginClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
