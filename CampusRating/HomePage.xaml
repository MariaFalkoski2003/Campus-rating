<?xml version="1.0" encoding="utf-8" ?>
<local:PaginaDoCampus xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:local="clr-namespace:CampusRating"
                     xmlns:vm="clr-namespace:CampusRating.ViewModels"
                     xmlns:model="clr-namespace:CampusRating.Modelos"
                     xmlns:ui="clr-namespace:CampusRating.Componentes"
                     x:Class="CampusRating.HomePage" x:DataType="vm:HomeViewModel"
                     Title="Locais" BackgroundColor="White">
    <Grid x:Name="PlacesPanel" RowDefinitions="Auto,*" Padding="24,20,24,0"
          MaximumWidthRequest="720" HorizontalOptions="Fill">
        <VerticalStackLayout Spacing="16" Margin="0,0,0,12">
            <Label Text="Locais do campus" Style="{StaticResource TituloDaPagina}" />
            <ui:AvisoDaInterface Titulo="Cópia no dispositivo" Mensagem="{Binding MensagemLocal}" />
            <Border Style="{StaticResource CampoDeEntrada}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                    <Image Source="search_outline.png" WidthRequest="20" HeightRequest="20" />
                    <Entry x:Name="SearchEntry" Grid.Column="1" Text="{Binding Busca, Mode=TwoWay}" Placeholder="Buscar local" />
                </Grid>
            </Border>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="CategoryButtons" Spacing="8">
                    <Button Text="Todos" CommandParameter="Todos" Style="{StaticResource FiltroSelecionado}" Clicked="OnCategoryClicked" />
                    <Button Text="Salas" CommandParameter="Salas" Style="{StaticResource FiltroDoCampus}" Clicked="OnCategoryClicked" />
                    <Button Text="Banheiros" CommandParameter="Banheiros" Style="{StaticResource FiltroDoCampus}" Clicked="OnCategoryClicked" />
                    <Button Text="Biblioteca" CommandParameter="Biblioteca" Style="{StaticResource FiltroDoCampus}" Clicked="OnCategoryClicked" />
                    <Button Text="Cantina" CommandParameter="Cantina" Style="{StaticResource FiltroDoCampus}" Clicked="OnCategoryClicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding CarregandoLocais}" Padding="20,32" Spacing="12">
                <ActivityIndicator IsRunning="{Binding CarregandoLocais}" Color="#6251D2" />
                <Label Text="Carregando os locais..." Style="{StaticResource TextoDeApoio}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding MostrarErroLocal}" Padding="0,24" Spacing="16">
                <ui:AvisoDaInterface Tom="Erro" Titulo="Não foi possível carregar os locais" Mensagem="{Binding ErroLocal}" />
                <Button Text="Tentar novamente" Clicked="OnRetryPlacesClicked" />
            </VerticalStackLayout>
            <CollectionView x:Name="PlacesCollection" ItemsSource="{Binding Places}" IsVisible="{Binding MostrarLocais}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,28" Spacing="8">
                        <Label Text="Nenhum local encontrado" Style="{StaticResource TituloDaSecao}" />
                        <Label Text="Experimente outro nome ou categoria." Style="{StaticResource TextoDeApoio}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:CampusPlace">
                        <Border Padding="0,14" StrokeThickness="0" BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaceTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="96,*" ColumnSpacing="16">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="112">
                                        <Image Source="{Binding Image}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="7">
                                        <Label Text="{Binding Name}" FontSize="18" />
                                        <Label Text="{Binding Location}" Style="{StaticResource TextoDeApoio}" />
                                        <Label Text="{Binding Description}" Style="{StaticResource TextoDeApoio}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Border Padding="9,4" BackgroundColor="#F0EBFC" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10" HorizontalOptions="Start">
                                            <Label Text="{Binding CommentsText}" FontSize="12" TextColor="#5140B5" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView Style="{StaticResource Divisor}" Margin="0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Text="Locais predefinidos do campus" Style="{StaticResource TextoDeApoio}" Margin="0,12,0,20" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</local:PaginaDoCampus>
