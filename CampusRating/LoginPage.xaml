<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusRating.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="28,78,28,44"
                             Spacing="0"
                             MaximumWidthRequest="560"
                             HorizontalOptions="Center">

            <Border WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6251D7" Offset="0" />
                        <GradientStop Color="#8172EA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Image Source="campus_building.png"
                       WidthRequest="44"
                       HeightRequest="44" />
            </Border>

            <Label Margin="0,22,0,0"
                   Text="Entrar"
                   TextColor="#202538"
                   FontSize="42"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Margin="0,4,0,38"
                   Text="Use seu e-mail institucional"
                   TextColor="#53566B"
                   FontSize="16"
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout Spacing="14">
                <Border Padding="14,8"
                        BackgroundColor="White"
                        Stroke="#9B8AF3"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                        <Image Source="login_email.png"
                               WidthRequest="23"
                               HeightRequest="23" />
                        <Entry x:Name="EmailEntry"
                               Grid.Column="1"
                               Keyboard="Email"
                               Placeholder="E-mail institucional"
                               PlaceholderColor="#8B8D9D"
                               TextColor="#202538"
                               FontSize="16"
                               ReturnType="Next"
                               Completed="OnEmailCompleted" />
                    </Grid>
                </Border>

                <Border Padding="14,8,8,8"
                        BackgroundColor="White"
                        Stroke="#9B8AF3"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="24,*,40" ColumnSpacing="12">
                        <Image Source="login_lock.png"
                               WidthRequest="23"
                               HeightRequest="23" />
                        <Entry x:Name="PasswordEntry"
                               Grid.Column="1"
                               Placeholder="Senha"
                               PlaceholderColor="#8B8D9D"
                               TextColor="#202538"
                               FontSize="16"
                               IsPassword="True"
                               ReturnType="Done"
                               Completed="OnPasswordCompleted" />
                        <ImageButton x:Name="PasswordVisibilityButton"
                                     Grid.Column="2"
                                     Source="login_eye.png"
                                     BackgroundColor="Transparent"
                                     Padding="8"
                                     Clicked="OnTogglePasswordVisibility" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border Margin="0,28,0,0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6953D9" Offset="0" />
                        <GradientStop Color="#7F6AE7" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Button x:Name="LoginButton"
                        Padding="14"
                        Text="Entrar"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        FontSize="18"
                        FontAttributes="Bold"
                        Clicked="OnLoginClicked" />
            </Border>

            <Grid Margin="0,26,0,14"
                  ColumnDefinitions="*,Auto,*"
                  ColumnSpacing="16">
                <BoxView HeightRequest="1"
                         Color="#D9D9E4"
                         VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="ou"
                       TextColor="#9293A3"
                       FontSize="14" />
                <BoxView Grid.Column="2"
                         HeightRequest="1"
                         Color="#D9D9E4"
                         VerticalOptions="Center" />
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="login_user_add.png"
                       WidthRequest="23"
                       HeightRequest="23" />
                <Button Text="Criar conta"
                        TextColor="#6A55DE"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        Clicked="OnCreateAccountClicked" />
            </HorizontalStackLayout>

            <Button Margin="0,10,0,0"
                    Text="Esqueci minha senha"
                    TextColor="#6A55DE"
                    BackgroundColor="Transparent"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Clicked="OnForgotPasswordClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
