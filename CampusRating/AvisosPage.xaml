<?xml version="1.0" encoding="utf-8" ?>
<local:PaginaDoCampus xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:local="clr-namespace:CampusRating"
                     xmlns:vm="clr-namespace:CampusRating.ViewModels"
                     xmlns:model="clr-namespace:CampusRating.Modelos"
                     xmlns:ui="clr-namespace:CampusRating.Componentes"
                     x:Class="CampusRating.AvisosPage" x:DataType="vm:HomeViewModel"
                     Title="Avisos" BackgroundColor="White">
    <Grid RowDefinitions="Auto,Auto,*" Padding="24,20,24,0" RowSpacing="16" MaximumWidthRequest="720" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Avisos" Style="{StaticResource TituloDaPagina}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Atualizar" Style="{StaticResource BotaoSecundario}" Clicked="OnRefreshNoticesClicked" />
        </Grid>
        <ui:AvisoDaInterface x:Name="AvisosMensagem" Grid.Row="1" Titulo="Respostas aos seus relatos" Mensagem="{Binding MensagemAvisos}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Avisos}" IsVisible="{Binding MostrarAvisos}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,28" Spacing="8">
                    <Label Text="Você está em dia" Style="{StaticResource TituloDaSecao}" />
                    <Label Text="As respostas da administração aparecerão aqui." Style="{StaticResource TextoDeApoio}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:AvisoDoAluno">
                    <VerticalStackLayout Spacing="10" Padding="0,14">
                        <Border Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="#EEE8FC" HorizontalOptions="Start">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Lida}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#F0EEF3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding LeituraTexto}" TextColor="#5140B5" FontSize="12" />
                        </Border>
                        <Label Text="{Binding LocalNome}" FontSize="19" />
                        <Label Text="{Binding Texto}" FontSize="15" LineHeight="1.3" MaxLines="3" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding DataTexto}" Style="{StaticResource TextoDeApoio}" FontSize="12" />
                        <Button Text="Abrir relato e resposta" Style="{StaticResource BotaoSecundario}" Clicked="OnNoticeClicked" />
                        <BoxView Style="{StaticResource Divisor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</local:PaginaDoCampus>
